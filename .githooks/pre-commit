#!/usr/bin/env bash
# .githooks/pre-commit
# Bloquea commits que intenten subir secretos o archivos sensibles.
# Configurar con: git config core.hooksPath .githooks
#
# Funciona en Git Bash (Windows), Linux y macOS.
# Solo bloquea archivos que esten en el "staged area" (git add).

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

# Lista de patrones prohibidos. Tambien deben estar en .gitignore, pero esto
# es una segunda red de seguridad para evitar 'git add -f' accidentales.
FORBIDDEN_PATTERNS=(
  '^master\.key$'
  '\.key$'
  '^ssh_connections\.json$'
  '^system_settings\.json$'
  '^conn-.*\.json$'
  '^fix-perm-.*\.json$'
  '^files-list\.json$'
  '\.pem$'
  '\.env$'
  '\.env\.local$'
  '\.env\.[a-z]+\.local$'
  '\.pfx$'
  '\.p12$'
)

# Solo nos importan los staged para add/modify/rename/copy (NO deletes).
# 'D' queda fuera intencionalmente: queremos permitir eliminar archivos
# sensibles pre-existentes (cleanup del repo).
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMRT)

if [ -z "$STAGED_FILES" ]; then
  echo -e "${YELLOW}[pre-commit]${NC} No hay archivos staged para agregar/modificar; nada que verificar."
  exit 0
fi

VIOLATIONS=0
while IFS= read -r file; do
  for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
    if echo "$file" | grep -qE "$pattern"; then
      echo -e "${RED}[pre-commit BLOQUEADO]${NC} Archivo sensible detectado:"
      echo -e "  ${RED}-->${NC} $file  (matchea patron: $pattern)"
      echo ""
      echo -e "${YELLOW}Los secretos NO deben subirse al repositorio."
      echo -e "Si este archivo es legitimo (por ejemplo, un .env.example):"
      echo -e "  1. Renombralo (ej: '.env.example')"
      echo -e "  2. O usa 'git commit --no-verify' solo si estas 100%% seguro${NC}"
      echo ""
      VIOLATIONS=$((VIOLATIONS + 1))
      break
    fi
  done
done <<< "$STAGED_FILES"

if [ "$VIOLATIONS" -gt 0 ]; then
  echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e "${RED} COMMIT RECHAZADO: ${VIOLATIONS} archivo(s) sensible(s) en stage.${NC}"
  echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  exit 1
fi

echo -e "${GREEN}[pre-commit]${NC} OK - ningun secreto detectado en $(echo "$STAGED_FILES" | wc -l) archivos."
exit 0
